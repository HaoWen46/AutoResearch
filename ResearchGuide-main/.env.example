# 复制为 .env 后填入密钥。不要把填好的 .env 发给别人或提交到公开仓库。
# OpenAI 兼容接口。DeepSeek 示例：deepseek-flash 最省（启研对它默认关掉思考模式）；要更强可换 deepseek-v4-pro。旧名 deepseek-chat 已列入停用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选：推理强度 low / high / max。只有支持的模型才填，不填就用模型默认值。
# LLM_REASONING_EFFORT=low

# 可选：管理员口令。设了之后，页面「连接模型」要带这个口令才能改服务器的密钥和地址；不设则只有服务器本机能改。
# ADMIN_TOKEN=

# 若使用其他兼容服务，改 BASE_URL / MODEL 即可，例如：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- 账号与数据（见 docs/DEPLOY.md「账号与数据」） ----------
# 库文件放在会保留的盘上。云函数的 /tmp 会随实例回收清空，账号和记录会一起丢。
# QIYAN_DB=/data/qiyan.db

# 微信登录：个人订阅号的「服务器配置」（见 docs/DEPLOY.md「账号与数据」）。不配就只能访客进入。
# WECHAT_TOKEN=            # 和公众号后台「服务器配置」里填的 Token 一样，随便一串长随机字符
# WECHAT_AES_KEY=          # 后台「随机生成」的 EncodingAESKey（43 位）。线上必须设：没有它消息体不签名，能被伪造
# WECHAT_APP_ID=           # 公众号的 AppID（开发者 ID），解密时核对
# WECHAT_ACCOUNT_ID=       # 公众号原始 ID（gh_ 开头），用来显示关注二维码；或者直接给图片地址 WECHAT_QR_URL
# WECHAT_QR_URL=
# WECHAT_ACCOUNT_NAME=启研
# 模型调用额度（每天，北京时间）：全站合计、绑了微信的人、访客。超了就当模型没开，功能回退到规则版。
# 一次调用约几分钱（DeepSeek flash，几千 token）；全站上限就是每天花费的上限。
# LLM_DAILY_TOTAL=2000
# LLM_DAILY_USER=150
# LLM_DAILY_GUEST=15
# 工作线程数（默认 128）。每个同步接口、每个流式对话占一个线程直到做完；设小了多人同时对话时别的请求排队
# QIYAN_THREADS=128
# 在反向代理后面时设 1，按 X-Forwarded-For 限频
# TRUST_PROXY=1
# 只在本机开发用：没配公众号时，登录页多一个「模拟微信发送」按钮。配了 WECHAT_TOKEN 就不生效。线上不要设。
# AUTH_DEV_CODES=1
